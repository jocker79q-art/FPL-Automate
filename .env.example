# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is already in .gitignore).

# ---------------------------------------------------------------------------
# FPL identity (your team ID is public info, visible in your FPL team URL:
# https://fantasy.premierleague.com/entry/<ID>/history -- not a secret, but
# it is personal to you so it lives in .env rather than in committed config).
# ---------------------------------------------------------------------------
FPL_TEAM_ID=9242093

# Optional: a mini-league ID (from the league's URL) to track your rank
# and rank movement over time. Leave blank to skip league tracking.
FPL_MINI_LEAGUE_ID=

# ---------------------------------------------------------------------------
# Safety switches (see README "Safety model"). All default to the safe state.
# ---------------------------------------------------------------------------
# Master kill switch. When true, the system refuses to do anything beyond
# read-only data fetch + report generation, regardless of other settings.
EMERGENCY_STOP=false

# Must be explicitly set to true, in a future phase, before any action is
# ever submitted to fantasy.premierleague.com on your behalf. Phase 1 of
# this project ships NO functional submission code at all -- this flag is
# wired through the config/execution-layer interface now so the behaviour
# is auditable later, but flipping it today does not enable anything.
ENABLE_AUTO_EXECUTION=false

# Maximum points-hit the system is allowed to *recommend* in a single
# gameweek without requiring you to explicitly override it (e.g. 4 = at
# most a single extra transfer beyond free ones). Recommendations above
# this are still shown, but flagged and never marked "approve".
MAX_TRANSFER_RISK=4

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/fpl_automate.db

# ---------------------------------------------------------------------------
# Networking / rate limiting for the FPL public API client
# ---------------------------------------------------------------------------
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
FPL_HTTP_TIMEOUT_SECONDS=15
FPL_MIN_REQUEST_INTERVAL_SECONDS=1.0
FPL_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Email notifications (SMTP). Leave EMAIL_NOTIFICATIONS_ENABLED=false to run
# with no notifications at all (reports are still written to ./reports).
# For Gmail, use an "App Password", never your real account password.
# ---------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=

LOG_LEVEL=INFO
